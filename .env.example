# Copy to .env.local and fill in. Never commit .env.local.

# ── Database ────────────────────────────────────────────────────────────────
# Local: the docker-compose service in this repo.
DATABASE_URL=postgresql://sda:sda@localhost:5433/system_design_academy
# Production (Vercel env var): your Neon pooled connection string, e.g.
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DB_POOL_MAX=5

# ── AI interviewer ──────────────────────────────────────────────────────────
# Provider abstraction lives in lib/ai/provider.ts.
#   google    — Gemini via @ai-sdk/google
#   anthropic — Claude via @ai-sdk/anthropic
#   mock      — deterministic scripted interviewer, used by tests and by any
#               environment without a key. The rest of the app is unaffected.
AI_PROVIDER=mock
AI_API_KEY=
# Optional overrides; blank uses the per-provider default in lib/ai/provider.ts.
AI_MODEL=
AI_MODEL_FAST=

# ── E2E ─────────────────────────────────────────────────────────────────────
# Playwright starts the app itself; point it at a scratch database if you do
# not want E2E runs touching your study progress.
E2E_DATABASE_URL=postgresql://sda:sda@localhost:5433/system_design_academy_test
